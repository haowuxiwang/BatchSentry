# ============================================================
# BatchSentry — Environment Variables (DEPRECATED)
# ============================================================
# ⚠️ 此文件已弃用。请通过设置页面配置，配置持久化到 config.json：
#   - 开发模式：项目根/config.json
#   - Frozen 模式：%APPDATA%/PBC/config.json
#
# 本文件仅作为旧版本迁移源：首次启动且 config.json 不存在时，
# config.py 会自动读取 .env 并迁移到 config.json，迁移后可删除 .env。
# ============================================================

# ── LLM Provider Selection ─────────────────────────────────
# Active provider — must be one of the providers configured below.
# Built-in: deepseek, siliconflow. Add more via LLM_PROVIDERS.
LLM_PROVIDER=deepseek

# ── Built-in Providers ─────────────────────────────────────
# DeepSeek (default LLM) — protocol=openai
DEEPSEEK_PROTOCOL=openai
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# SiliconFlow (alternative provider) — protocol=openai
SILICONFLOW_PROTOCOL=openai
SILICONFLOW_API_KEY=sk-your-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Pro

# ── Custom Providers ───────────────────────────────────────
# Comma-separated list of additional provider names to register.
# Each name gets its own <NAME>_PROTOCOL / _API_KEY / _BASE_URL / _MODEL vars.
# Example: glm,kimi,qwen,mimo,anthropic
LLM_PROVIDERS=

# ── Example: GLM (Zhipu) — OpenAI-compatible ───────────────
# Add "glm" to LLM_PROVIDERS, then set:
# GLM_PROTOCOL=openai
# GLM_API_KEY=your-glm-key
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4-plus

# ── Example: Kimi (Moonshot) — OpenAI-compatible ────────────
# KIMI_PROTOCOL=openai
# KIMI_API_KEY=your-kimi-key
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=moonshot-v1-32k

# ── Example: Qwen (DashScope compatible mode) — OpenAI-compatible
# QWEN_PROTOCOL=openai
# QWEN_API_KEY=your-qwen-key
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# ── Example: MiMo (Xiaomi) — OpenAI-compatible ──────────────
# MIMO_PROTOCOL=openai
# MIMO_API_KEY=your-mimo-key
# MIMO_BASE_URL=https://api.mimo.xiaomi.com/v1
# MIMO_MODEL=mimo-7b

# ── Example: Anthropic Claude — Anthropic Messages API ────
# Requires: pip install anthropic
# ANTHROPIC_PROTOCOL=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── OCR Backend ────────────────────────────────────────────
# PaddleOCR-VL API (external OCR service)
PADDLE_OCR_API_URL=https://your-paddle-ocr-service.example.com/predict
PADDLE_OCR_TOKEN=your-token-here
PADDLE_OCR_MODEL=PaddleOCR-VL-1.6

# MinerU 精准解析 API (可选 OCR 后端)
# Token 在 https://mineru.net/apiManage 页面创建
# 切换为 MinerU 后端需设置 OCR_BACKEND=mineru
MINERU_TOKEN=your-mineru-token-here
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true

# OCR 后端选择: paddle (默认) | mineru
OCR_BACKEND=paddle

# MinerU 分片 OCR（流式）：每片页数。>1 时启用切片：PDF 按片并行提交，
# 单片 OCR 完成立即开始该片页面 LLM 分析（无需等全部页 OCR 完成）。
# 仅 OCR_BACKEND=mineru 时生效；=1 保持原有整份阻塞式流程。
OCR_SLICES=1

# ── App Config ─────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=data/pharma.db
OUTPUT_DIR=output

# Concurrency: max simultaneous active jobs (pending/ocr/analyzing).
# Each pipeline holds OCR result + LLM JSON in memory; 3 × 200MB PDFs ≈ 2GB.
MAX_CONCURRENT_JOBS=3

# LLM context window (tokens) — cross-page summary budget derivation (Round 7).
# The summary must stay ≤ ~35% of the window; adapt when switching to a
# smaller-window model (e.g. GLM/Kimi 32K → LLM_CONTEXT_WINDOW=32768) so
# multi-hundred-page jobs truncate gracefully instead of overflowing.
LLM_CONTEXT_WINDOW=128000

# Concurrency: per-job LLM page analysis parallelism (Stage 2).
# 5 concurrent calls × 250s/page ≈ 51 pages in ~42min (vs 3.5h serial).
# Raise cautiously — provider rate limits apply (DeepSeek: ~50 RPM).
LLM_CONCURRENCY=5
