# Build artifacts
dist/
# Electron 产物。含标准目录 dist-electron/ 与自愈备用目录（build.ps1 检测到
# dist-electron\win-unpacked 被安全软件占用时会自动改写为
# -c.directories.output=dist-electron-locked 并尽力归位）。
dist-electron*/
build/
# 历史版本的归档 zip（CLAUDE.md「Repo hygiene」规则 2 指示打包到此，故必须忽略）。
# ⚠️ 这条曾经缺失：规则让 agent 往 release-archive/ 写 zip，忽略清单却不拦 ——
# 规则与忽略清单不一致时，agent 会照规则做，然后 zip 出现在 git status 里。
# 新增任何"允许写入的产物落点"必须**同一次提交**补进本文件（机检见
# tests/unit/test_repo_hygiene.py）。
release-archive/
*.spec.bak

# PyInstaller
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.installed.cfg

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
.mimocode/
.workbuddy/
.trae/
.npm-cache/

# OS
.DS_Store
Thumbs.db
desktop.ini

# App data (dev) — repo-root only. NOTE: the pattern must stay root-anchored
# (`/data/`), otherwise it also swallows `core/kb/data/`, which is the
# *committed* knowledge-base corpus (see seed_kb.py / .gitignore line ~122).
/data/
/output/
*.db
*.db-journal
*.db-wal
*.db-shm

# Secrets
.env
.env.local
.env.production
config.json
config.json.bak*

# Logs
*.log
logs/
server_err.log
server_out.log

# Test coverage artifacts
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# Spike test artifacts
spike_phase*.log
spike_*.png
screenshot*.png

# Sample documents (large binaries — keep out of git)
samples/*.pdf
samples/*.docx

# E2E test images (manual upload fixtures, keep out of git)
test*.jpg
test*.png

# Temporary spike scripts (one-shot, not part of app)
spike_phase*.py
_flip_status.py

# Pytest temp output files
pytest_out.txt
pytest_full.txt
pytest_subset.txt
pytest_result.txt
pytest_clean.txt
pytest_final.txt
pytest_final2.txt
pytest_v3.txt
cov_result.txt
cov_tmp.json
coverage.json
test_results.xml
.coverage.*
cache/

# Spike 探索/一次性实验（设计笔记与临时脚本，不属于应用）。
# 整个目录忽略，**不再按扩展名逐个列举** —— 按扩展名挡不住新形态：
# 实测 `touch spike/__probe__.png` 会让 `git status` 立刻报 `?? spike/`。
# CLAUDE.md 把该目录列为 agent 可写入的落点，故必须整目录忽略（机检见
# tests/unit/test_repo_hygiene.py）。
spike/


cov.xml


# Spike ad-hoc experiments (one-shot scripts + run logs)
# 已由上面的 `spike/` 整目录覆盖；保留本节仅为记录"这些形态曾经存在"，
# 新增 spike 产物时**不需要**再往这里加一行。

# 真实批记录样本（含企业数据，禁止入库）
丝裂霉素提取批记录.pdf
# 第二份真实批记录（海正药业 海博麦布片 10mg，批号 72408119，10 页 A4 扫描件）——
# 异地/异产品/异版式，用于泛化验证；同样含手写签名与批号 ⇒ 禁入库。
# 需要时由用户放到仓库根目录，本地 e2e 直接引用文件名即可（不入库不影响使用）。
试用批记录.pdf
# 该记录的局部放大标注图（用户手工圈出规格与实测值），含手写签名/复核者姓名 ⇒ 禁入库
用户标注.png
*_normalized.pdf
e2e_*.log
# e2e 运行时 SSE 帧证据（e2e_run.py 采集，运行产物不进库）
e2e_sse_*.jsonl
_tmp_*.pdf
# 合成 e2e PDF（gen_e2e_pdf.py / gen_e2e_rot_pdf.py 可再生）
e2e_test.pdf
e2e_rot.pdf

# KB seed source binary (derived JSON ships instead)
docs/*.doc
# dev-time temp patch scripts
_patch_*.py

# Dev-time artifacts archive (moved from repo root, all regenerable)
devlogs/

# 申报材料（含联系人 PII，禁止入库）
AI智造典型案例申报表.docx
