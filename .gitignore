cov.xml


# Spike ad-hoc experiments (one-shot scripts + run logs)
spike/*.py
spike/*.log
spike/*.json
spike/*.md

# 真实批记录样本（含企业数据，禁止入库）
丝裂霉素提取批记录.pdf
*_normalized.pdf
e2e_*.log
# e2e 运行时 SSE 帧证据（e2e_run.py 采集，运行产物不进库）
e2e_sse_*.jsonl
_tmp_*.pdf
# 合成 e2e PDF（gen_e2e_pdf.py / gen_e2e_rot_pdf.py 可再生）
e2e_test.pdf
e2e_rot.pdf

# KB seed source binary (derived JSON ships instead)
docs/*.doc
# dev-time temp patch scripts
_patch_*.py

# Dev-time artifacts archive (moved from repo root, all regenerable)
devlogs/

